#include <iostream>
#include <vector>
#include <string>
#include <iomanip>

using namespace std;

// Estructura b�sica que representa un producto en la ferreter�a
struct Producto {
	string codigo;
	string nombre;
	double precio;
	int stock;
	int tipo; // 1: Unidad normal, 2: Material a granel/peso, 3: Herramienta con garant�a
};

class Tienda {
private:
	vector<Producto> productos;
	double totalVentas;
	int cantidadVentasRealizadas;
	
public:
	// Constructor
	Tienda() {
		totalVentas = 0.0;
		cantidadVentasRealizadas = 0;
		cargarDatosIniciales();
	}
	
	// M�todo auxiliar para precargar datos iniciales de prueba
	void cargarDatosIniciales() {
		productos.push_back({"P001", "Tornillo_3_pulgadas", 250.0, 100, 1});
		productos.push_back({"P002", "Cable_Electrico_Metro", 1800.0, 50, 2});
		productos.push_back({"P003", "Taladro_Percutor_750W", 185000.0, 4, 3}); // Stock bajo intencional para F5
		productos.push_back({"P004", "Martillo_U�a", 25000.0, 12, 1});
	}
	
	// ==========================================
	// FUNCI�N F1: Registrar productos
	// ==========================================
	void registrarProducto() {
		cout << "\n=========================================\n";
		cout << "       REGISTRAR NUEVO PRODUCTO (F1)   \n";
		cout << "=========================================\n";
		
		Producto p;
		cout << "Ingrese codigo del producto (Ej: P005): ";
		cin >> p.codigo;
		
		for (const auto& prod : productos) {
			if (prod.codigo == p.codigo) {
				cout << "[ERROR] Ya existe un producto registrado con el codigo " << p.codigo << ".\n";
				return;
			}
		}
		
		cout << "Ingrese nombre del producto: ";
		cin >> p.nombre;
		cout << "Ingrese precio unitario ($): ";
		cin >> p.precio;
		cout << "Ingrese stock inicial (unidades): ";
		cin >> p.stock;
		cout << "Seleccione el tipo de producto:\n";
		cout << "  1. Producto por unidad normal\n";
		cout << "  2. Material a granel / medida\n";
		cout << "  3. Herramienta con garantia de fabrica\n";
		cout << "Opcion tipo: ";
		cin >> p.tipo;
		
		if (p.tipo < 1 || p.tipo > 3) {
			cout << "[ADVERTENCIA] Tipo invalido. Se asignara por defecto como Tipo 1.\n";
			p.tipo = 1;
		}
		
		productos.push_back(p);
		cout << "\n[EXITO] Producto registrado correctamente en el inventario.\n";
	}
	
	// ==========================================
	// FUNCI�N F2: Consultar el inventario
	// ==========================================
	void consultarInventario() {
		cout << "\n=================================================================\n";
		cout << "               INVENTARIO ACTUAL DE LA TIENDA (F2)[cite: 3]     \n";
		cout << "=================================================================\n";
		
		if (productos.empty()) {
			cout << "No hay productos registrados actualmente en el sistema.\n";
			cout << "=================================================================\n";
			return;
		}
		
		cout << left << setw(10) << "CODIGO" 
							<< setw(25) << "NOMBRE" 
							<< setw(15) << "PRECIO ($)" 
							<< setw(10) << "STOCK" 
							<< setw(10) << "TIPO" << "\n";
		cout << "-----------------------------------------------------------------\n";
		
		for (const auto& p : productos) {
			cout << left << setw(10) << p.codigo 
				<< setw(25) << p.nombre 
				<< setw(15) << fixed << setprecision(2) << p.precio 
				<< setw(10) << p.stock 
				<< setw(10) << p.tipo << "\n";
		}
		cout << "=================================================================\n";
	}
	
	// ==========================================
	// FUNCI�N F3: Registrar una venta
	// ==========================================
	void registrarVenta() {
		cout << "\n=========================================\n";
		cout << "         REGISTRAR UNA VENTA (F3)[cite: 3]      \n";
		cout << "=========================================\n";
		
		if (productos.empty()) {
			cout << "[ERROR] No hay productos disponibles para realizar ventas.\n";
			return;
		}
		
		consultarInventario();
		
		string codigoBuscado;
		int cantidadDeseada;
		int formaPago;
		
		cout << "\nIngrese el codigo del producto que desea vender: ";
		cin >> codigoBuscado;
		
		bool encontrado = false;
		for (auto& p : productos) {
			if (p.codigo == codigoBuscado) {
				encontrado = true;
				cout << "Ingrese la cantidad a comprar: ";
				cin >> cantidadDeseada;
				
				if (cantidadDeseada <= 0) {
					cout << "[ERROR] La cantidad debe ser mayor a cero.\n";
					return;
				}
				
				if (p.stock < cantidadDeseada) {
					cout << "[ERROR] Stock insuficiente. Solo hay " << p.stock << " unidades disponibles.\n";
					return;
				}
				
				double subtotal = p.precio * cantidadDeseada;
				double recargoOImpuesto = 0.0;
				
				// F4: Aplicaci�n de impuestos seg�n tipo de producto (Antipatr�n switch)
				switch (p.tipo) {
				case 1: recargoOImpuesto = subtotal * 0.19; break; // IVA 19%
				case 2: recargoOImpuesto = subtotal * 0.05; break; // Impuesto empaque
				case 3: recargoOImpuesto = (subtotal * 0.19) + 5000.0; break; // IVA + Garant�a
				default: recargoOImpuesto = subtotal * 0.19; break;
				}
				
				double totalConImpuestos = subtotal + recargoOImpuesto;
				
				cout << "\nSeleccione la forma de pago:\n";
				cout << "  1. Efectivo\n";
				cout << "  2. Tarjeta Debito / Credito\n";
				cout << "  3. Transferencia Bancaria\n";
				cout << "Opcion de pago: ";
				cin >> formaPago;
				
				double descuentoAplicado = 0.0;
				if (formaPago == 2) {
					descuentoAplicado = totalConImpuestos * 0.03;
					totalConImpuestos -= descuentoAplicado;
				} else if (formaPago == 3) {
					descuentoAplicado = totalConImpuestos * 0.03;
					totalConImpuestos -= descuentoAplicado;
					totalConImpuestos += 800.0;
				}
				
				// F5: Control de stock (descuento de unidades)
				p.stock -= cantidadDeseada;
				
				if (p.stock < 5) {
					cout << "\n-------------------------------------------------\n";
					cout << "[! ALERTA DE STOCK MINIMO !] (F5)[cite: 3]\n";
					cout << "El producto [" << p.nombre << "] ha quedado con " << p.stock << " unidades.\n";
					cout << "-------------------------------------------------\n";
				}
				
				totalVentas += totalConImpuestos;
				cantidadVentasRealizadas++;
				
				cout << "\n---------------- FACTURA DE VENTA ----------------\n";
				cout << "Producto     : " << p.nombre << " (" << p.codigo << ")\n";
				cout << "Cantidad     : " << cantidadDeseada << "\n";
				cout << "Subtotal     : $" << fixed << setprecision(2) << subtotal << "\n";
				cout << "Impuestos/Gar: $" << recargoOImpuesto << "\n";
				cout << "Descuentos   : -$" << descuentoAplicado << "\n";
				cout << "TOTAL A PAGAR: $" << totalConImpuestos << "\n";
				cout << "--------------------------------------------------\n";
				cout << "[EXITO] Venta registrada correctamente.\n";
				break;
			}
		}
		
		if (!encontrado) {
			cout << "[ERROR] Producto no encontrado.\n";
		}
	}
	
	// ==========================================
	// FUNCI�N F4: Aplicar descuentos o impuestos
	// (Demostraci�n directa de pol�ticas)
	// ==========================================
	void aplicarDescuentosImpuestosMenu() {
		cout << "\n=========================================\n";
		cout << "    APLICAR DESCUENTOS / IMPUESTOS (F4)[cite: 3] \n";
		cout << "=========================================\n";
		cout << "Esta funcion se aplica de forma automatizada al registrar una venta (Opcion 3).\n";
		cout << "Reglas actuales:\n";
		cout << " - Tipo 1 (Normal): IVA del 19%[cite: 15]\n";
		cout << " - Tipo 2 (Granel): Impuesto de empaque del 5%\n";
		cout << " - Tipo 3 (Garantia): IVA 19% + Recargo fijo de $5000\n";
		cout << " - Descuento por Tarjeta o Transferencia: 3%[cite: 15]\n";
		cout << "=========================================\n";
	}
	
	// ==========================================
	// FUNCI�N F5: Controlar el stock
	// (Auditor�a manual de niveles cr�ticos)
	// ==========================================
	void controlarStockMenu() {
		cout << "\n=========================================\n";
		cout << "        CONTROL DE STOCK MINIMO (F5)[cite: 3]   \n";
		cout << "=========================================\n";
		bool hayAlertas = false;
		for (const auto& p : productos) {
			if (p.stock < 5) {
				cout << "[ALERTA] Producto: " << p.nombre << " | Stock actual: " << p.stock << " (Critico < 5)\n";
				hayAlertas = true;
			}
		}
		if (!hayAlertas) {
			cout << "Todos los productos cuentan con niveles de stock adecuados (>= 5).\n";
		}
		cout << "=========================================\n";
	}
	
	// ==========================================
	// FUNCI�N F6: Reporte de ventas
	// ==========================================
	void reporteDeVentas() {
		cout << "\n=========================================\n";
		cout << "         REPORTE DE VENTAS (F6)[cite: 3]        \n";
		cout << "=========================================\n";
		cout << "Total de transacciones realizadas : " << cantidadVentasRealizadas << "\n";
		cout << "Dinero total recaudado en caja    : $" << fixed << setprecision(2) << totalVentas << "\n";
		cout << "=========================================\n";
	}
	
	// ==========================================
	// Men� Principal de la Consola
	// ==========================================
	void ejecutarMenu() {
		int opcion = 0;
		do {
			cout << "\n=================================================================\n";
			cout << "          FERRETERIA 'EL TORNILLO FIEL' (VERSION 0)[cite: 1, 2]             \n";
			cout << "=================================================================\n";
			cout << " 1. Registrar productos (F1)[cite: 3]\n";
			cout << " 2. Consultar el inventario (F2)[cite: 3]\n";
			cout << " 3. Registrar una venta (F3)[cite: 3]\n";
			cout << " 4. Aplicar descuentos o impuestos (F4)[cite: 3]\n";
			cout << " 5. Controlar el stock (F5)[cite: 3]\n";
			cout << " 6. Reporte de ventas (F6)[cite: 3]\n";
			cout << " 7. Salir del sistema\n";
			cout << "=================================================================\n";
			cout << "Seleccione una opcion (1-7): ";
			cin >> opcion;
			
			switch (opcion) {
			case 1: registrarProducto(); break;
			case 2: consultarInventario(); break;
			case 3: registrarVenta(); break;
			case 4: aplicarDescuentosImpuestosMenu(); break;
			case 5: controlarStockMenu(); break;
			case 6: reporteDeVentas(); break;
			case 7: cout << "\nSaliendo del sistema de la ferreteria. �Hasta pronto!\n"; break;
			default: cout << "\n[ERROR] Opcion no valida. Intente de nuevo.\n"; break;
			}
		} while (opcion != 7);
	}
};

int main() {
	Tienda miTienda;
	miTienda.ejecutarMenu();
	return 0;

}
